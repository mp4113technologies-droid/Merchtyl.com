# Server-only credentials. Copy to .env locally; never commit populated values.
SPRING_DATASOURCE_URL=<jdbc-postgresql-url; production must include sslmode=require-or-verify-full>
SPRING_DATASOURCE_USERNAME=<database-username>
SPRING_DATASOURCE_PASSWORD=<database-password>
POSTGRES_ADMIN_URL=<postgres-admin-url-used-only-for-local-setup>
MERCHTYL_JWT_SECRET=<random-secret-at-least-32-characters>
RESEND_API_KEY=<resend-api-key>
MERCHTYL_TEST_USER_PROVISIONING_KEY=<local-test-provisioning-key>
MERCHTYL_TEST_DEFAULT_USER_PASSWORD=<local-test-user-password>
MERCHTYL_BOOTSTRAP_SUPERADMIN_PASSWORD=<one-time-bootstrap-password>

# Server configuration.
SPRING_PROFILES_ACTIVE=dev
MERCHTYL_JWT_ISSUER=merchtyl-dev
MERCHTYL_CORS_ALLOWED_ORIGINS=http://localhost:5173
MERCHTYL_CORS_ALLOWED_ORIGIN_PATTERNS=
MERCHTYL_FRONTEND_BASE_URL=http://localhost:5173
MERCHTYL_PUBLIC_BASE_DOMAIN=localhost
MERCHTYL_PLATFORM_BASE_URL=http://localhost:5173
MERCHTYL_EMAIL_PROVIDER=console
MERCHTYL_EMAIL_FROM_ADDRESS=
MERCHTYL_EMAIL_FROM_NAME=Merchtyl
MERCHTYL_EMAIL_REPLY_TO=
MERCHTYL_CONTACT_EMAIL_TO=
MERCHTYL_CONTACT_EMAIL_FROM=
RESEND_ENABLED=false
MERCHTYL_TEST_USER_PROVISIONING_ENABLED=false
MERCHTYL_BOOTSTRAP_SUPERADMIN_ENABLED=false
MERCHTYL_BOOTSTRAP_SUPERADMIN_EMAIL=
MERCHTYL_BOOTSTRAP_SUPERADMIN_NAME=Merchtyl Administrator
MERCHTYL_RATE_LIMIT_ENABLED=true
MERCHTYL_RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
MERCHTYL_RATE_LIMIT_AUTH_WINDOW=1m
MERCHTYL_RATE_LIMIT_PASSWORD_RESET_MAX_ATTEMPTS=3
MERCHTYL_RATE_LIMIT_PASSWORD_RESET_WINDOW=1h
MERCHTYL_RATE_LIMIT_CONTACT_MAX_ATTEMPTS=5
MERCHTYL_RATE_LIMIT_CONTACT_WINDOW=10m
SWAGGER_UI_ENABLED=false
SWAGGER_API_DOCS_ENABLED=false

# Browser-visible Vite values. Never put secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8080
VITE_PUBLIC_BASE_DOMAIN=localhost
